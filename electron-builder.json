{
  "appId": "com.company.gestionaledipendentioffline",
  "productName": "GPA 1.0.4",
  "directories": {
    "output": "release",
    "buildResources": "build/resources"
  },
  "files": [
    "dist/**/*",
    "src/main/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/**/*.node",
    "node_modules/@napi-rs/canvas/**/*",
    "node_modules/better-sqlite3/**/*",
    "src/main/pdf-ocr",
    "resources/tessdata/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/tessdata",
      "to": "tessdata",
      "filter": [
        "**/*"
      ]
    }
  ],
  "afterPack": "tools/fix-pdf-ocr-perms.cjs",
  "npmRebuild": false,
  "extraMetadata": {
    "name": "gestionale",
    "main": "src/main/main.js",
    "appVariant": "standard"
  },
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "win": {
    "executableName": "GPA 1.0.4",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/resources/icon.ico",
    "publisherName": "Publisher modificabile",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "GPA 1.0.4",
    "uninstallDisplayName": "GPA 1.0.4",
    "deleteAppDataOnUninstall": false,
    "displayLanguageSelector": false
  }
}
